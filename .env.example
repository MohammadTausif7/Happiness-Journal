# Public URL used for metadata and social sharing links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production readiness placeholders for later increments.
# These are intentionally unused by the local demo implementation.
DATABASE_URL=
AUTH_SECRET=
ENCRYPTION_KEY=
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
APP_ENV=development

# One-time contribution checkout placeholders.
# Increment 6 validates the checkout request, but live payments remain disabled
# until these server-only values are configured in production.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_DONATION_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/journal?contribution=success
STRIPE_CANCEL_URL=http://localhost:3000/contribute?contribution=cancelled
