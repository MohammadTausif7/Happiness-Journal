# Public URL used for metadata and social sharing links.
# Production deployment: https://happiness-journal-web.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DATA_MODE=local

# Production server configuration.
DATABASE_URL=
DATABASE_SSL=true
AUTH_SECRET=
ENCRYPTION_KEY=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
APP_ENV=development

# One-time contribution checkout.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/journal?contribution=success
STRIPE_CANCEL_URL=http://localhost:3000/contribute?contribution=cancelled
